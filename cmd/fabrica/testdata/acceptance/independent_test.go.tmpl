func TestIndependentReconciliationRuntime(t *testing.T){
 viper.Reset();config:=DefaultConfig();config.DataDir=t.TempDir()
 if config.ReconcileWorkers!={{.Workers}}{t.Fatalf("worker default=%d",config.ReconcileWorkers)}
 gate:=make(chan struct{});reconcilers.AcceptanceGate=gate
 released:=false;release:=func(){if !released{close(gate);released=true}};defer release()
 features,err:=loadGeneratedFeatures(context.Background(),config);if err!=nil{t.Fatal(err)};defer func(){release();features.Close()}()
 bus:=events.GetGlobalEventBus();if bus==nil{t.Fatal("missing event bus")}
 for i:=0;i<config.ReconcileWorkers+1;i++{
  n:=&api.Node{Kind:"Node",APIVersion:"v1"};n.Metadata.UID=fmt.Sprintf("node-%08d",i);n.Metadata.Name=n.Metadata.UID;n.Spec.Description="preserved"
  if err:=storage.SaveNode(context.Background(),n);err!=nil{t.Fatal(err)}
  if err:=events.PublishResourceEvent(context.Background(),"created","Node",n.GetUID(),n);err!=nil{t.Fatal(err)}
 }
 var active []string
 for i:=0;i<config.ReconcileWorkers;i++{select{case uid:=<-reconcilers.AcceptanceEntered:active=append(active,uid);case <-time.After(5*time.Second):t.Fatalf("only %d workers started",len(active))}}
 select{case uid:=<-reconcilers.AcceptanceEntered:t.Fatalf("more than configured workers started: %s",uid);case <-time.After(50*time.Millisecond):}
 closed:=make(chan struct{});go func(){features.Close();close(closed)}()
 select{case <-closed:t.Fatal("shutdown did not wait for active reconciliations");case <-time.After(50*time.Millisecond):}
 if events.GetGlobalEventBus()!=bus{t.Fatal("bus closed before controller stopped")}
 release()
 select{case <-closed:case <-time.After(5*time.Second):t.Fatal("shutdown did not finish")}
 if events.GetGlobalEventBus()!=nil{t.Fatal("bus leaked after reconciliation shutdown")}
 for _,uid:=range active{n,err:=storage.LoadNode(context.Background(),uid);if err!=nil||!n.Status.Ready||n.Status.Message!="acceptance reconciled"||n.Spec.Description!="preserved"{t.Fatalf("reconciliation did not preserve spec and persist status: %+v %v",n,err)}}
 raw,err:=storage.Backend.Load(context.Background(),"Node",active[0]);if err!=nil{t.Fatal(err)}
 reconciler:=reconcilers.NewDefaultNodeReconciler(storage.NewStorageClient(),nil)
 result,err:=reconciler.Reconcile(context.Background(),raw);if err!=nil||result.RequeueAfter!={{.Minutes}}*time.Minute{t.Fatalf("generated periodic result=%+v err=%v",result,err)}
 config=DefaultConfig();config.DataDir=t.TempDir();config.ReconcileWorkers=0
 failed,err:=loadGeneratedFeatures(context.Background(),config);if err==nil{failed.Close();t.Fatal("invalid runtime worker count accepted")};failed.Close()
 if events.GetGlobalEventBus()!=nil{t.Fatal("startup failure leaked event bus")}
}
