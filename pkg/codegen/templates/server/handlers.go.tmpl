func respond{{.Name}}RevisionError(w http.ResponseWriter, err error) {
	var conflict *revision.ConflictError
	if errors.As(err, &conflict) {
		respondJSON(w, http.StatusConflict, RevisionConflictResponse{
			Error: err.Error(), ExistingRevisionUID: conflict.ExistingRevisionUID,
			ExistingDigest: conflict.ExistingDigest, RequestedDigest: conflict.RequestedDigest,
		})
		return
	}
	var precondition *revision.PreconditionError
	if errors.As(err, &precondition) {
		respondJSON(w, http.StatusPreconditionFailed, RevisionPreconditionResponse{Error: err.Error(), CurrentETag: precondition.CurrentETag})
		return
	}
	status := http.StatusInternalServerError
	switch {
	case errors.Is(err, revision.ErrSeriesExists), errors.Is(err, revision.ErrRevisionNameConflict):
		respondJSON(w, http.StatusConflict, RevisionConflictResponse{Error: err.Error()})
		return
	case errors.Is(err, revision.ErrRevisionInUse):
		status = http.StatusConflict
	case errors.Is(err, revision.ErrRevisionRetired):
		status = http.StatusGone
	case errors.Is(err, revision.ErrPreconditionFailed):
		respondJSON(w, http.StatusPreconditionFailed, RevisionPreconditionResponse{Error: err.Error()})
		return
	case errors.Is(err, revision.ErrSeriesNotFound), errors.Is(err, revision.ErrRevisionNotFound):
		status = http.StatusNotFound
	case errors.Is(err, revision.ErrInvalidReference), errors.Is(err, revision.ErrUnsupportedSelector):
		status = http.StatusBadRequest
	}
	respondError(w, status, err)
}
