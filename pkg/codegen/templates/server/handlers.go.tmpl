// Delete{{.Name}} deletes a {{.Name}} resource
func Delete{{.Name}}(w http.ResponseWriter, r *http.Request) {
	uid := chi.URLParam(r, "uid")
	if uid == "" {
		respondError(w, http.StatusBadRequest, fmt.Errorf("{{.Name}} UID is required"))
		return
	}

	// Atomically load and delete the resource before publishing the event.
	{{camelCase .Name}}, err := mutate{{.Name}}(r, uid, func({{camelCase .Name}} *{{.PackageAlias}}.{{.Name}}) (bool, error) { return true, nil })
	if err != nil {
		respond{{.Name}}MutationError(w, r, err)
		return
	}

	// Publish resource deleted event
	deleteMetadata := map[string]interface{}{
		"deletedAt": time.Now(),
	}
{{if .IsVersioned}}
	if err := events.PublishResourceDeleted(r.Context(), "{{.Name}}", {{camelCase .Name}}.Metadata.UID, {{camelCase .Name}}.Metadata.Name, deleteMetadata); err != nil {
		// Log the error but don't fail the request - events are non-critical
		fmt.Printf("Warning: Failed to publish resource deleted event for {{.Name}} %s: %v\n", {{camelCase .Name}}.Metadata.UID, err)
{{else}}
	if err := events.PublishResourceDeleted(r.Context(), "{{.Name}}", {{camelCase .Name}}.GetUID(), {{camelCase .Name}}.GetName(), deleteMetadata); err != nil {
		// Log the error but don't fail the request - events are non-critical
		fmt.Printf("Warning: Failed to publish resource deleted event for {{.Name}} %s: %v\n", {{camelCase .Name}}.GetUID(), err)
{{end}}
	}

	respondJSON(w, http.StatusOK, &DeleteResponse{
		Message: "{{.Name}} deleted successfully",
		UID:     uid,
	})
}

// {{.Name}}MutationError carries an HTTP status out of a storage callback.
type {{.Name}}MutationError struct {
	status int
	err    error
	etag   string
}

func (e *{{.Name}}MutationError) Error() string { return e.err.Error() }
func (e *{{.Name}}MutationError) Unwrap() error { return e.err }

func respond{{.Name}}MutationError(w http.ResponseWriter, r *http.Request, err error) {
	var mutationErr *{{.Name}}MutationError
	if errors.As(err, &mutationErr) {
		{{if .ConditionalEnabled}}
		if mutationErr.status == http.StatusPreconditionFailed {
			conditionalmiddleware.CheckIfMatch(w, r, mutationErr.etag)
			return
		}
		{{end}}
		respondError(w, mutationErr.status, mutationErr.err)
		return
	}
	{{if .ConditionalEnabled}}
	if errors.Is(err, fabricaStorage.ErrAtomicMutationUnsupported) {
		respondError(w, http.StatusNotImplemented, err)
		return
	}
	if errors.Is(err, fabricaStorage.ErrNotFound) {
		respondError(w, http.StatusNotFound, err)
		return
	}
	{{end}}
	respondError(w, http.StatusInternalServerError, err)
}

// mutate{{.Name}} checks the precondition and applies the change to the same stored
// representation. The callback may be retried and must have no external effects.
func mutate{{.Name}}(r *http.Request, uid string, apply func(*{{.PackageAlias}}.{{.Name}}) (bool, error), bookkeeping ...bool) (*{{.PackageAlias}}.{{.Name}}, error) {
	{{if .ConditionalEnabled}}
	ifMatch := r.Header.Get("If-Match")
	if len(bookkeeping) > 0 {
		ifMatch = ""
	}
	if _, ok := storage.Backend.(fabricaStorage.AtomicMutationBackend); ok || ifMatch != "" || len(bookkeeping) > 0 {
		return fabricaStorage.MutateResource[*{{.PackageAlias}}.{{.Name}}](r.Context(), storage.Backend, "{{.Name}}", uid, func(current *{{.PackageAlias}}.{{.Name}}) (bool, error) {
			if ifMatch != "" {
				etag, err := conditionalmiddleware.GenerateETag(current)
				if err != nil {
					return false, err
				}
				if !conditionalmiddleware.MatchesIfMatch(ifMatch, etag) {
					return false, &{{.Name}}MutationError{status: http.StatusPreconditionFailed, err: fmt.Errorf("precondition failed"), etag: etag}
				}
			}
			return apply(current)
		})
	}
	{{end}}
	current, err := storage.Load{{.StorageName}}(r.Context(), uid)
	if err != nil {
		return nil, &{{.Name}}MutationError{status: http.StatusNotFound, err: err}
	}
	remove, err := apply(current)
	if err != nil {
		return nil, err
	}
	if remove {
		err = storage.Delete{{.StorageName}}(r.Context(), uid)
	} else {
		err = storage.Save{{.StorageName}}(r.Context(), current)
	}
	return current, err
}

