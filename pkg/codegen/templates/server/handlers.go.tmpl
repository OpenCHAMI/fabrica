// persist{{.Name}}SnapshotVersion updates only the server-managed snapshot field,
// and refuses to overwrite a resource changed since the spec mutation committed.
func persist{{.Name}}SnapshotVersion(r *http.Request, uid string, committedResource *{{.PackageAlias}}.{{.Name}}, versionID string) (*{{.PackageAlias}}.{{.Name}}, error) {
	committed, err := json.Marshal(committedResource)
	if err != nil {
		return nil, err
	}
	return mutate{{.Name}}(r, uid, func(current *{{.PackageAlias}}.{{.Name}}) (bool, error) {
		actual, err := json.Marshal(current)
		if err != nil {
			return false, err
		}
		if string(actual) != string(committed) {
			return false, fmt.Errorf("resource changed before snapshot bookkeeping")
		}
		current.Status.Version = versionID
		return false, nil
	}, true)
}
