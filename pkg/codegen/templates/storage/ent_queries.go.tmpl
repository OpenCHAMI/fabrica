// ensureEntClient verifies the ent client has been initialized
func ensureEntClient() {
    if entClient == nil {
        panic("ent client not initialized: call SetEntClient in main.go before using storage")
    }
}

// QueryResources returns a generic query builder for a given kind
func QueryResources(ctx context.Context, kind string) *ent.ResourceQuery {
    ensureEntClient()
    switch kind { {{range .Resources}}{{if isDedicated .}}case "{{.Name}}": panic("{{.Name}} uses dedicated storage; use Query{{.PluralName}}")
    {{end}}{{end}}}

    return entClient.Resource.Query().
        Where(entresource.KindEQ(kind))
}

// QueryResourcesByLabels queries resources by kind and exact-match labels
func QueryResourcesByLabels(ctx context.Context, kind string, labels map[string]string) (*ent.ResourceQuery, error) {
    ensureEntClient()
    switch kind { {{range .Resources}}{{if isDedicated .}}case "{{.Name}}": return nil,fmt.Errorf("{{.Name}} uses dedicated storage; use Query{{.PluralName}}ByLabels")
    {{end}}{{end}}}

    q := entClient.Resource.Query().Where(entresource.KindEQ(kind))
    for k, v := range labels {
        q = q.Where(entresource.HasLabelsWith(
            label.KeyEQ(k),
            label.ValueEQ(v),
        ))
    }
    return q, nil
}

{{range .Resources}}{{if isDedicated .}}
// Query{{.PluralName}} returns the dedicated {{.Name}} query builder.
// Like the generic builder, this panics when storage is unavailable.
func Query{{.PluralName}}(ctx context.Context) *ent.{{.Name}}Query {
    ensureEntClient()
    if err:=check{{.Name}}Layout(ctx,entClient);err!=nil {panic(err)}
    return entClient.{{.Name}}.Query()
}

func Query{{.PluralName}}ByLabels(ctx context.Context, labels map[string]string)(*ent.{{.Name}}Query,error) {
    if err:=check{{.Name}}Layout(ctx,entClient);err!=nil {return nil,err}
    q:=entClient.{{.Name}}.Query()
    for k,v:=range labels {
        q=q.Where(func(s *sql.Selector){s.Where(sqljson.ValueEQ(s.C("envelope"),v,sqljson.Path("metadata","labels",k)))})
    }
    return q,nil
}

func Get{{.Name}}ByUID(ctx context.Context,uid string)({{.TypeName}},error) {return Load{{.StorageName}}(ctx,uid)}

func List{{.PluralName}}ByLabels(ctx context.Context,labels map[string]string)([]{{.TypeName}},error) {
    q,err:=Query{{.PluralName}}ByLabels(ctx,labels);if err!=nil {return nil,err}
    entities,err:=q.All(ctx);if err!=nil {return nil,err}
    out:=make([]{{.TypeName}},0,len(entities))
    for _,entity:=range entities {value,err:=FromEnt{{.Name}}(ctx,entity);if err!=nil {return nil,err};out=append(out,value)}
    return out,nil
}
{{else}}
// Query{{.PluralName}} returns a query builder for {{.PluralName}}
func Query{{.PluralName}}(ctx context.Context) *ent.ResourceQuery {
    return QueryResources(ctx, "{{.Name}}")
}

// Get{{.Name}}ByUID loads a single {{.Name}} by UID
func Get{{.Name}}ByUID(ctx context.Context, uid string) ({{.TypeName}}, error) {
    ensureEntClient()
    r, err := entClient.Resource.Query().
        Where(entresource.UIDEQ(uid), entresource.KindEQ("{{.Name}}")).
        WithLabels().
        WithAnnotations().
        Only(ctx)
    if err != nil {
        if ent.IsNotFound(err) {
            return nil, ErrNotFound
        }
        return nil, fmt.Errorf("failed to load {{.Name}} %s: %w", uid, err)
    }
    v, err := FromEntResource(ctx, r)
    if err != nil {
        return nil, err
    }
    return v.(*{{.PackageAlias}}.{{.Name}}), nil
}

// List{{.PluralName}}ByLabels returns {{.PluralName}} matching all provided labels
func List{{.PluralName}}ByLabels(ctx context.Context, labels map[string]string) ([]{{.TypeName}}, error) {
    q, err := QueryResourcesByLabels(ctx, "{{.Name}}", labels)
    if err != nil {
        return nil, err
    }
    rs, err := q.WithLabels().WithAnnotations().All(ctx)
    if err != nil {
        return nil, err
    }
    out := make([]{{.TypeName}}, 0, len(rs))
    for _, r := range rs {
        v, err := FromEntResource(ctx, r)
        if err != nil {
            continue
        }
        out = append(out, v.(*{{.PackageAlias}}.{{.Name}}))
    }
    return out, nil
}
