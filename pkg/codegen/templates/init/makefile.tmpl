.PHONY: help build test clean run

# Service binary name
BINARY_NAME={{.ProjectName}}
GO=go
GOFLAGS=-v

# Version information - extracted from git or set to defaults
VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo "dev")
COMMIT ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo "unknown")
DATE ?= $(shell date -u +"%Y-%m-%dT%H:%M:%SZ")

# Build ldflags to embed version information
LDFLAGS=-ldflags "-X main.serviceVersion=$(VERSION) -X main.serviceCommit=$(COMMIT) -X main.serviceDate=$(DATE)"

help: ## Display this help screen
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-30s\033[0m %s\n", $$1, $$2}'

build: ## Build the service binary
	$(GO) build $(GOFLAGS) $(LDFLAGS) -o bin/$(BINARY_NAME) ./cmd/server

build-client: ## Build the client binary
	$(GO) build $(GOFLAGS) -ldflags "-X main.clientVersion=$(VERSION) -X main.clientCommit=$(COMMIT) -X main.clientDate=$(DATE)" -o bin/$(BINARY_NAME)-cli ./cmd/client

run: build ## Build and run the service
	./bin/$(BINARY_NAME) serve

test: ## Run tests
	$(GO) test $(GOFLAGS) ./...

clean: ## Clean build artifacts
	rm -rf bin/ dist/
	$(GO) clean -cache

install: ## Install dependencies
	$(GO) mod download
	$(GO) mod verify

tidy: ## Tidy go.mod
	$(GO) mod tidy

fmt: ## Format code
	$(GO) fmt ./...

vet: ## Run go vet
	$(GO) vet ./...

.DEFAULT_GOAL := help
