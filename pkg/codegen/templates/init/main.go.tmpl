func bindFlagsWithUnderscoreKeys(flags *pflag.FlagSet) error {
	var bindErr error

	flags.VisitAll(func(flag *pflag.Flag) {
		if bindErr != nil {
			return
		}

		key := strings.ReplaceAll(flag.Name, "-", "_")
		bindErr = viper.BindPFlag(key, flag)
	})

	return bindErr
}

